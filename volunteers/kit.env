# The census volunteer kit's fixed settings (VOLUNTEERS.md). scripts/volunteer/census.sh sources this file;
# backend/census_volunteer.py reads it for scripts/volunteer/volunteer_tool.py, scripts/census_board.py and
# scripts/census_intake.py. Every layer a volunteer takes is the home card's layer 45 run's command at another layer
# (experiments/results/census_L45_whole/), so the layers stand side by side, with the design whose trial passed at
# that layer. A change of any value here is a new kit: raise KIT, tag the commit census-kit-<KIT>, take the home
# canaries again (scripts/census_intake.py home-canaries).
# Kit 1 (census-kit-1, 30 October 2026) took layers 40-44 and 46-50, all done by 11 November. Kit 2 (census-kit-2, 12
# November) was the same command at every layer left, and opened layers 39 and 51, where break_rel's trials passed.
# Kit 3 gives each layer the design whose trial passed there: break_rel still at 39 and 51, the command kit 2 took
# them with, and two designs that count a push in each neuron's own write ceiling at the layers break_rel's doses
# overdrive or underdrive. Nothing that writes a break_rel answer changed.
KIT=3
KIT_TAG=census-kit-3
# the layers the kit may take, counting from 0 (page = layer + 1). The board says which of them are open, and
# census.sh reserve asks the board: a layer is opened only once its trial on the home card has passed with its design
# (ROADMAP section vi; experiments/results/census_neighbour_trials/, census_soft_trials/, census_match_trials/,
# census_match_walk/). 32-39, 51 and 52 have passed. 53-59 are named so that one which passes later with soft_ceil can
# be opened without a new kit; none of them has been trialled with it, and until one is they stay shut on the board
KIT_LAYERS="32 33 34 35 36 37 38 39 51 52 53 54 55 56 57 58 59"
# the design each layer is taken with, layer:design (the script picks it; nothing here is the volunteer's to choose):
#   match_ceil  two counts of each neuron's write ceiling set a layer at a time, where the next word-piece moves by
#               1.0 and by 1.4 nats (census.MATCH_CEIL): layers 32-37, each on a trial of its own (13 November 2026)
#   soft_ceil   +-1.6 and +-2.3 of each neuron's write ceiling: layers 38 and 52, each on a trial of its own (13 November)
#   break_rel   +-1 and +-2 of the stream, kits 1 and 2's design: layers 39 and 51 (12 November)
KIT_DESIGNS="32:match_ceil 33:match_ceil 34:match_ceil 35:match_ceil 36:match_ceil 37:match_ceil 38:soft_ceil 39:break_rel 51:break_rel 52:soft_ceil 53:soft_ceil 54:soft_ceil 55:soft_ceil 56:soft_ceil 57:soft_ceil 58:soft_ceil 59:soft_ceil"
KIT_NEURONS=all
KIT_CONTROLS=2048
KIT_SEED=7
KIT_BATCH=64
KIT_MAX_NEW=48
KIT_UNPACKER=compiled
# the home venv's exact versions (scripts/export_constraints.sh), the stats index the push's unit is read from
KIT_CONSTRAINTS=scripts/pod/constraints/home-2026-10-30.txt
KIT_ACT_SCALE_SHA256=23a6dcefaf4eae99222c334a8294f773e37e4f20cbf36b63344a73fd5c2911fa
# (the file kit 1 fetched, at the same address under the repository's new name: one stats index for every layer)
KIT_ACT_SCALE_URL=https://github.com/whp199/theodolite/releases/download/census-kit-1/act_scale.npz
# where claims are posted and the board is kept: the pinned issue (scripts/census_board.py publish), and the board as
# the scripts read it (census.sh reserve: is the layer open?)
KIT_BOARD_URL=https://github.com/whp199/theodolite/issues/1
KIT_BOARD_JSON_URL=https://raw.githubusercontent.com/whp199/theodolite/main/volunteers/board.json
# what a machine needs: one card holding the model and a batch of 64, and the disk for the checkpoint, the lenses, the
# venv and a run. The model rests at 17.97 GiB on the card and the longest batch of 64 (walk, every row to 48 pieces)
# reaches 22.1 GiB allocated, so a 24 GB card takes part, but only with nothing else on it: on a headless RTX 3090
# (24,124 MiB free) the worst batches were written with 256 MiB held aside and not with 384
# (scripts/measure_batches.py --hold-mib). census.sh check asks for the free memory as well as the size
KIT_MIN_VRAM_MIB=24000
KIT_MIN_FREE_VRAM_MIB=23900
KIT_MIN_DISK_GB=60
KIT_MIN_CUDA=13.0
# on the CPU stand-in (census.sh --dry-run, scripts/check_volunteer_kit.py): its 6 layers, 128 neurons a layer; one
# layer a design, so a kit of more than one design is run end to end (match_ceil has no doses for a stand-in layer)
KIT_DRY_LAYERS="2 3"
KIT_DRY_DESIGNS="2:break_rel 3:soft_ceil"
KIT_DRY_NEURONS=0-11
KIT_DRY_CONTROLS=4
KIT_DRY_BATCH=4
KIT_DRY_MAX_NEW=8
